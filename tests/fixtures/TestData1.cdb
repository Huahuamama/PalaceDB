			"lines": [
				{
					"Id": "golf",
					"Title": "高尔夫球场",
					"Des": "是时候练练球技了。",
					"RstText": "golf1, golf2, golf3, golf4",
					"Priority": 0,
					"RstValue": "money-5, golf+1",
					"Condition": "money>=5",
					"EventType": 2,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "golf1",
					"Title": "",
					"Des": "",
					"RstText": "你发现打高尔夫球很难，但用球杆打人很简单。",
					"Priority": 0,
					"EventType": 4,
					"RstValue": "end+5, str+5",
					"Condition": "golf<=3",
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "golf2",
					"Title": "",
					"Des": "",
					"RstText": "你和另一名球手起了纠纷，于是用球杆互殴。",
					"Priority": 0,
					"RstValue": "end+5, str+5",
					"Condition": "golf<=3",
					"EventType": 4,
					"Icon": "",
					"Rarity": 0
				},
				{
