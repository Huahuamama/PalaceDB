			"lines": [
				{
					"Id": "swim1",
					"Title": "热天午后",
					"Des": "",
					"RstText": "你在后院的泳池度过了一个悠闲的下午。你读了一本书，皮肤也晒得很均匀。",
					"Priority": 0,
					"RstValue": "int+1, pop+2, books+1",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "boat_party",
					"Title": "生日派对",
					"Des": "",
					"RstText": "你爸要在你生日那天出差，不能陪你庆祝了。为了弥补，他把公司的游艇借给你办派对。",
					"Priority": 0,
					"RstValue": "pop+3",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "home_alone",
					"Title": "小鬼当家",
					"Des": "",
					"RstText": "你的父母出门了。你一个人在家想干什么都行！于是你请了所有的同学在家开派对，甚至还邀请了那个最不受欢迎的孩子。你可真是善良呀。",
					"Priority": 0,
					"RstValue": "pop+3",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "vacation",
					"Title": "假日",
					"Des": "",
					"RstText": "你们全家去河畔的度假别墅里过周末。你在河上练习驾驶帆船。",
					"Priority": 0,
					"RstValue": "agi+3",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "trolls",
					"Title": "网络喷子",
					"Des": "",
					"RstText": "你在网上晒自己的卧室布置，不知道从哪里冒出来几个喷子骂你暴发户、品味差。你生气地注销了账号，觉得上天对你非常不公平！",
					"Priority": 0,
					"RstValue": "str+3",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				}
			],
			"separators": [],
			"props": {}
		},
