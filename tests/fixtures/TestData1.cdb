					"Rarity": 0
				},
				{
					"Id": "chick_vegan",
					"Title": "炸素鸡",
					"Des": "脆香鸡炸鸡店推出了植物肉炸鸡。同样的口感，更环保的选择！",
					"Condition": "money>=10",
					"Priority": 0,
					"RstText": "你舔了舔手指，还想再来一份。",
