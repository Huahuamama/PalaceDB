			"lines": [
				{
					"Id": "bicycle",
					"Title": "新车上路",
					"Des": "",
					"RstText": "你爸爸给你买了一辆新的自行车。你现在出行更方便了。",
					"Priority": 0,
					"RstValue": "end+2, str+1,bike=1",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "football1",
					"Title": "街头足球",
					"Des": "",
					"RstText": "你在小巷子里与邻居的小孩们踢球。",
					"Priority": 0,
					"RstValue": "str+3",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "protest",
					"Title": "抗议",
					"Des": "",
					"RstText": "你的父母和邻居们一起上街抗议生活成本上涨，你也跟着去了。",
					"Priority": 0,
					"RstValue": "pop+1, end+2",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "scam",
					"Title": "诈骗",
					"Des": "",
					"RstText": "你爸爸在网上被人忽悠买了一堆没用的保健品。吃一堑，长一智，希望你以后不要上同样的当。",
					"Priority": 0,
					"RstValue": "int+2, money-20",
					"Condition": "money>=20",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "coming_of_age",
					"Title": "叛逆期",
					"Des": "",
					"RstText": "你迷上了重金属摇滚乐。",
					"Priority": 0,
					"RstValue": "pop+3, music=1",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "kitchen_killer",
					"Title": "炸厨房小能手",
					"Des": "",
					"RstText": "你开始学习烹饪，家里的烟雾报警器一星期响了八次。",
					"Priority": 0,
					"RstValue": "agi+3",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				}
			],
			"separators": [],
			"props": {}
		},
