			"lines": [
				{
					"Id": "slum1",
					"Title": "皱巴巴的课本",
					"Des": "",
					"RstText": "楼上的水管又爆了，你的课本全都打湿了，晒了三天三夜才干。一些笔记变得看不清了。",
					"Priority": 0,
					"RstValue": "int-1",
					"EventType": 0,
					"Icon": "",
					"Tags": 0,
					"Rarity": 0
				},
				{
					"Id": "slum2",
					"Title": "手工活",
					"Des": "",
					"RstText": "妈妈接了手工活赚钱，在家里给玩偶缝眼睛。你帮她缝了一点，她很高兴地给了你零花钱。",
					"Priority": 0,
					"RstValue": "agi+1,money+10",
					"EventType": 0,
					"Icon": "",
					"Tags": 8,
					"Rarity": 0
				},
				{
					"Id": "haircut",
					"Title": "理发",
					"Des": "",
					"RstText": "你在楼下理了一个新发型，人人都夸你的新发型好看。",
					"Priority": 0,
					"RstValue": "pop+3, money-1",
					"Condition": "money>=1",
					"EventType": 0,
					"Icon": "",
					"Tags": 0,
					"Rarity": 0
				},
				{
					"Id": "construction",
					"Title": "拆迁",
					"Des": "",
					"RstText": "你们的公寓楼要拆迁了。作为租客你们没有拿到补偿，并且只能搬到附近一个租金更贵的地方。新的住处虽然租金稍贵，但邻居更加友善。",
					"Priority": 0,
					"RstValue": "pop+2, money-2",
					"Condition": "money>=2, gangster==0",
					"EventType": 0,
					"Icon": "",
					"Tags": 0,
					"Rarity": 0
				},
				{
					"Id": "old_clothes1",
					"Title": "“新”衣服",
					"Des": "",
					"RstText": "妈妈从她做帮佣的豪宅里拿了几件衣服给你，都是那家的孩子扔掉的。你发现每一件都是大牌，有些连吊牌都没拆过。[p]你美滋滋地穿上了。",
					"Priority": 0,
					"RstValue": "pop+5",
					"EventType": 0,
					"Icon": "",
					"Tags": 0,
					"Rarity": 0
				},
				{
					"Id": "old_clothes2",
					"Title": "“新”衣服",
					"Des": "",
					"RstText": "妈妈从她做帮佣的豪宅里拿了几件衣服给你，都是那家的孩子扔掉的。你发现每一件都是大牌，有些连吊牌都没拆过。[p]犹豫再三，你还是把它们挂到网上卖了。",
					"Priority": 0,
					"RstValue": "money+200",
					"Condition": "money<50",
					"EventType": 0,
					"Icon": "",
					"Tags": 8,
					"Rarity": 0
				}
			],
			"separators": [],
			"props": {}
		},
