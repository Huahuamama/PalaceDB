			"lines": [
				{
					"Id": "carnival",
					"Title": "嘉年华",
					"Des": "一年一度的嘉年华开始了。",
					"RstText": "carnival1,  carnival1_1, carnival1_2, carnival1_3, carnival2,   carnival2_1, carnival2_2, carnival3, carnival3_1, carnival3_2, carnival3_3, carnival3_4",
					"Priority": 1,
					"EventType": 2,
					"Condition": "money>=40, season==0",
					"Icon": "",
					"Rarity": 0,
					"RstValue": "money-40"
				},
				{
					"Id": "carnival1",
					"Title": "",
					"Des": "",
					"RstText": "你在过山车上吐了，呕吐物自高空倾泻而下。",
					"Priority": 0,
					"RstValue": "end+5",
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"Condition": "end<30"
				},
				{
					"Id": "carnival1_1",
					"Title": "",
					"Des": "",
					"RstText": "你坐海盗船有些头晕，所幸没有吐出来。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"Condition": "end>=30, end<60",
					"RstValue": "end+6"
				},
				{
					"Id": "carnival1_2",
					"Title": "",
					"Des": "",
					"RstText": "你坐在跳楼机上跟其他客人喝茶聊天。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"RstValue": "end+5",
					"Condition": "end>=60"
				},
				{
					"Id": "carnival1_3",
					"Title": "",
					"Des": "",
					"RstText": "你和恋人一起坐了摩天轮。随着你们越升越高，你感到心跳越来越快。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"RstValue": "pop+1, end+4, lover_quarrel-1",
					"Condition": "isInLove==1"
				},
				{
					"Id": "carnival2",
					"Title": "",
					"Des": "",
					"RstText": "你用气枪不小心射中了摊主两次。摊主把钱还你了，求你别再射了。",
					"Priority": 0,
					"RstValue": "pop-1, agi+6, money+40",
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"Condition": "agi<30"
				},
				{
					"Id": "carnival2_1",
					"Title": "",
					"Des": "",
					"RstText": "你用气枪射击移动的鸭子。看起来你的成绩不差，但你知道，每次你瞄准了这个，打中的却是另外一个。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"Condition": "agi>=30, agi<60",
					"RstValue": "agi+6"
				},
				{
					"Id": "carnival2_2",
					"Title": "",
					"Des": "",
					"RstText": "你用气枪打靶，百发百中，最后赢了一个巨大的河马玩偶。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"Condition": "agi>=60",
					"RstValue": "agi+5"
				},
				{
					"Id": "carnival3",
					"Title": "",
					"Des": "",
					"RstText": "你拎起木槌猛击敲钟机，滑块却纹丝不动。",
					"Priority": 0,
					"RstValue": "str+5",
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"Condition": "str<30"
				},
				{
					"Id": "carnival3_1",
					"Title": "",
					"Des": "",
					"RstText": "你试了几次敲钟机，但是每次都差那么一点。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"RstValue": "str+6",
					"Condition": "str<60, str>=30"
				},
				{
					"Id": "carnival3_2",
					"Title": "",
					"Des": "",
					"RstText": "你挥动木槌，猛击敲钟机。机器顶部的铃铛瞬间响起，周围的人群也爆发出一阵欢呼。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"Condition": "str>=60, str<90",
					"RstValue": "str+5"
				},
				{
					"Id": "carnival3_3",
					"Title": "",
					"Des": "",
					"RstText": "“是时候见证我空手道的练习成果了。”面对敲钟机，你不用木槌，徒手劈了下去。只听得“叮”的一声，你就知道你成功了。[p]人群十分安静，他们还处于震撼之中无法自拔。你的手火辣辣地疼，也不知道是不是肿了。但这时候可不能露出你怕疼的样子！你迈着大步离开，希望能给人们留下一个帅气的形象。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"Condition": "str>=90, str<100, karate_class>1",
					"RstValue": "str+10"
				},
				{
					"Id": "carnival3_4",
					"Title": "",
					"Des": "",
					"RstText": "你拎起木槌，对着敲钟机轻轻一击。滑块瞬间起飞，冲破了机器顶端，飞到天上变成了一颗星星。[p]“糟了，弄坏机器可是要赔钱的呀！”你趁着其他人还没回过神来，赶紧溜了。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"Rarity": 0,
					"RstValue": "str+10",
					"Condition": "str>=90, str<100"
				},
				{
					"Id": "mascot",
					"Title": "嘉年华的吉祥物",
					"Des": "嘉年华正在请人扮演河马市的吉祥物河宝。",
					"RstText": "你穿上河宝的玩偶服，成为了整个嘉年华最受欢迎的巨星。游客们排着队要和你合照。",
					"Priority": 1,
					"RstValue": "money+60, end+4",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0,
					"Tags": 24,
					"Condition": "season==0"
				},
				{
