				{
					"typeStr": "5:,Uncommon,Rare",
					"name": "Rarity",
					"display": null
				}
			],
			"lines": [
				{
					"Id": "rc0",
					"Title": "平凡的你",
					"Des": "你的同学们都有各自的特长：有的能用意念弯曲勺子，有的能透视墙壁，有的能喷吐蛛丝……只有你什么都不会，考试成绩也是垫底的。",
					"RstText": "你向校长说出了自己的烦恼，她温柔地拍了拍你的头，说你只要做个乖孩子，就会变得和同学们一样厉害。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc1",
					"Title": "美术课",
					"Des": "美术老师让大家用水彩颜料自由涂鸦。你画了一个长着蜥蜴头的人形怪物。",
					"RstText": "老师很严肃地问你在哪里看到过这种怪物，你说自己只是想到就画了。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc2",
					"Title": "接种疫苗",
					"Des": "为了保护孩子们不生病，每过几个月，老师们就会帮学生接种疫苗。今天又到了接种的日子。",
					"RstText": "打完疫苗后，你感觉浑身无力，老师特许你在宿舍里休息几天。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc3",
					"Title": "热夜之梦",
					"Des": "你躺在床上迷迷糊糊地睡着了。梦中，你坐在一个奇怪的教室里，墙壁上开着方形的洞。老师的脸上没有面罩，同学也穿着五颜六色的衣服。",
					"RstText": "梦里的老师说了很多奇怪的事，都是你闻所未闻的东西。醒来之后你一个字都不记得了，但你觉得自己的思路清晰了许多。",
					"Priority": 0,
					"RstValue": "int+100",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc4",
					"Title": "扑克牌游戏",
					"Des": "今天不上课，你和同学们一起打牌。",
					"RstText": "有透视能力的千里眼同学赢了游戏，但他坚称自己没有作弊。",
					"Priority": 0,
					"RstValue": "pop+10",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc5",
					"Title": "考试日",
					"Des": "这次的考试，你一反常态地考了满分。校长奖励了你一些购物积分。",
					"RstText": "你用购物积分兑换了一台电子辞典。你可以用它来自学许多课外知识。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc6",
					"Title": "突触改造药水",
					"Des": "你现在要学的东西太多了，感到有些力不从心。校长给你打了一针，说这种新药能加快神经传导的速度。",
					"RstText": "突然间，你感觉整个世界都慢了下来。然后你马上意识到这是因为你变快了。",
					"Priority": 0,
					"RstValue": "agi+100",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc7",
					"Title": "形而上学",
					"Des": "在看了一些哲学书之后，你开始思考世界的本质。学院之外是否还存在着更大的世界？你决定在电子辞典里寻找答案。",
					"RstText": "你翻遍了所有的资料，但是没有一篇提到学院之外的事情。也许是你想多了。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc8",
					"Title": "足球友谊赛",
					"Des": "体育课上，你们分成两组踢足球玩。",
					"RstText": "整场比赛就只有两个同学在较量，一个能隔空取物，另一个能瞬间移动，剩下的同学全叉着腰看戏。你们决定下次不带这两个人一起玩了。",
					"Priority": 0,
					"RstValue": "pop+10",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc9",
					"Title": "接种疫苗",
					"Des": "再一次接种疫苗后，你又做了怪梦：头顶没有天花板，只有一望无际的蓝色，还有一个很大很亮的火球……",
					"RstText": "你满头大汗地醒来，被子都被汗水濡湿了。你下了床，感觉自己充满了力量。",
					"Priority": 0,
					"RstValue": "str+100",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc10",
					"Title": "小小黑客",
					"Des": "你自学了编程，成功通过电子辞典黑入了学院的局域网。",
					"RstText": "你偷偷地往自己的账户上增加了一点购物积分。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc11",
					"Title": "天花板之上",
					"Des": "你和有透视能力的千里眼同学在操场上散步。你突然灵机一动，让千里眼看看天花板上面有没有什么东西。",
					"RstText": "“我看到一个很圆很亮的东西，呃……实在太亮了！”说完，他痛苦地捂住了眼睛。[p]真奇怪，他说的和你梦到的完全一样。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc12",
					"Title": "十全大补丸",
					"Des": "由于你最近频频发烧，校长关切地给你带来了一盒药，她说可以增强你的体质。",
					"RstText": "你每天服用一颗药片，坚持了一个月后，确实感觉自己健壮了不少。",
					"Priority": 0,
					"RstValue": "end+100",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc13",
					"Title": "年度测验",
					"Des": "今年测验的结果，你几乎在每项数据上都达到了满分，只在社交能力上被评为“不合群”。",
					"RstText": "校长鼓励你多和同学们一起玩，不要老是把自己关在房间里学习。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc14",
					"Title": "同学们",
					"Des": "为了锻炼自己的社交能力，你自告奋勇做了班长。",
					"RstText": "你组织了很多课外活动，和同学们一起度过了许多快乐的时光。你们的友谊加深了。",
					"Priority": 0,
					"RstValue": "pop+20",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc15",
					"Title": "学习会",
					"Des": "你和几个同学一起复习迎考，互相帮助。",
					"RstText": "在下一次考试中，大家的成绩都有所提升。",
					"Priority": 0,
					"RstValue": "pop+20",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc16",
					"Title": "失踪的同学",
					"Des": "在班级活动的时候，你突然发现有一个同学很久都没有露面了。",
					"RstText": "你问了身边的同学和老师，但是他们都说没有这个人。难道是你记错了？",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc17",
					"Title": "被删除的文件",
					"Des": "你在学院的数据库里搜索那个失踪的同学，只搜到一份被删除的文件。",
					"RstText": "你恢复了文件的部分数据。这份文件提到了“学院项目”、“基因改造”、“实验品”、“处死”等关键词，落款是“河马市医学研究中心”。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc18",
					"Title": "河马市",
					"Des": "顺着这份被删除的文件，你突破了学院局域网的防火墙，来到一片奇怪的网域。",
					"RstText": "你了解到一个叫“河马市”的地方，那里的人们的生活方式，和你从小被灌输的常识完全不同。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc19",
					"Title": "醒悟",
					"Des": "你明白了一切！",
					"RstText": "原来你的整个人生都是谎言。实验中心圈养了你们，目的是改造出拥有完美基因的新人类。[p]你决心要逃离这里。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc20",
					"Title": "伺机逃跑",
					"Des": "你照常学习、生活，寻找可以逃跑的机会。",
					"RstText": "你也开始试探身边的同学们，找到了几个可能愿意和你一起逃跑的人。",
					"Priority": 0,
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc21",
					"Title": "召集伙伴",
					"Des": "这天晚上，你借口开学习会，把朋友们都叫到了房间里……",
					"RstText": "大家一开始很难接受真相，但在看到你收集的资料后，他们决定跟你一起逃跑。",
					"Priority": 10,
					"Condition": "round==21",
					"RstValue": "pop+20",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc22",
					"Title": "逃跑计划",
					"Des": "你和同伴们发挥各自的专长，成功获取了研究中心的地图和一张通行卡。终于到了行动的时候。[p]你黑入电网，切断了学院的电源。",
					"RstText": "除了实验室有备用电源以外，整个学院都陷入了一片漆黑。你和同伴们趁乱溜出宿舍，在迷宫般的走廊里狂奔。出口近在眼前了。",
					"Priority": 10,
					"Condition": "round==22",
					"RstValue": "pop+20",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc23",
					"Title": "自由的味道",
					"Des": "大门的守卫还没来得及呼叫，就被蛛网吊了起来。你和大力士一起撞开了大门，猛烈的阳光刺得你睁不开眼睛。",
					"RstText": "你的眼睛渐渐适应了日光。你的眼前浮现出了蓝天，草地，还有远处山脚下的河马市……",
					"Priority": 10,
					"Condition": "round==23",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc24",
					"Title": "十面埋伏",
					"Des": "一群守卫从四面八方包围了你们。你被什么东西击中了，重重地摔到了地上。同伴们接二连三地倒下，在你的眼前被打成筛子。",
					"RstText": "“真可惜，你本来是我最好的实验品。”你听到了校长的声音。[p]她走近你，摘下了面罩，你看到了一张爬虫类的脸。你失去了意识。",
					"Priority": 10,
					"Condition": "round==24",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc25",
					"Title": "生还是死",
					"Des": "你早就该死了，但你还活着，而且变得更强——无论他们如何射击、劈砍、灼烧，你的肉体都会马上恢复原状，而且你再也感受不到任何痛苦了。",
					"RstText": "即使隔着厚厚的面罩，你也能感到他们的恐惧。你被关进了学院最深处的地下。",
					"Priority": 10,
					"Condition": "round==25",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc26",
					"Title": "守卫",
					"Des": "看守你的工作人员总是以欺负你为乐。虽然你的肉体不再会感到痛觉，但并不代表你没有脾气。",
					"RstText": "这次，他玩过火了。你逮住机会狠狠地咬了他一口。[p]他尖叫着跑了出去，但是你知道，他还会再回来的。",
					"Priority": 10,
					"Condition": "round==26",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc27",
					"Title": "孤独",
					"Des": "自那以后，再也没有人来看过你了。照明、通风和监控设备一个接一个地关闭了，只有紧急出口的指示牌还亮着。",
					"RstText": "又过了不知道多久，连指示牌的灯也灭了。你在黑暗中静静地等待着，反正你有的是时间。",
					"Priority": 10,
					"Condition": "round==27",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc28",
					"Title": "等待与希望",
					"Des": "你等啊等……",
					"RstText": "你突然想明白了一件事情：河马市和学院是一样的！",
					"Priority": 10,
					"Condition": "round==28",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc29",
					"Title": "奇妙的呼唤",
					"Des": "有人在呼唤你。一开始只是一个微弱的念头，很快就变成了清晰的声音：[p]“王啊，请你指引我们吧！”",
					"RstText": "这些声音越来越多，越来越响。虽然你并不清楚到底发生了什么，但你知道在某个遥远的地方，有很多同类正需要你的帮助。",
					"Priority": 10,
					"Condition": "round==29",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc30",
					"Title": "聚沙成塔",
					"Des": "你试图向同类下达指令。",
					"RstText": "你发出了这样的指令：“去召集更多的同伴，然后来救我！我在河马市医疗实验中心的地下！”",
					"Priority": 10,
					"Condition": "round==30",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "rc31",
					"Title": "等待的终点",
					"Des": "就快结束了。",
					"RstText": "你听到门外传来了嘈杂的声音……",
					"Priority": 10,
					"Condition": "round==31",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				}
			],
