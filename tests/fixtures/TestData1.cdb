			"lines": [
				{
					"Id": "go_to_school",
					"Title": "上学",
					"Des": "一个平凡的上学日。",
					"RstText": "你早早地到了学校，和同学们打招呼，上课，做笔记，吃三明治，打瞌睡。一切都平平无奇，你感觉这样的日子好像会永远持续下去。",
					"Priority": 0,
					"EventType": 16,
					"Icon": "school",
					"Tags": 32,
					"RstValue": "int+4, intCount+1",
					"Rarity": 0
				},
				{
					"Id": "homework1",
					"Title": "忘记作业",
					"Des": "你到了学校才发现自己少写了一项作业。",
					"RstText": "homework1_1, homework1_2, homework1_3",
					"Priority": 0,
					"EventType": 18,
					"Icon": "school",
					"Tags": 0,
					"RstValue": "intCount+1",
					"Rarity": 0
				},
				{
					"Id": "homework1_1",
					"Title": "",
					"Des": "",
					"RstText": "老师根本没收作业，而是发了答案让你们自己批改。你成功蒙混过关。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"RstValue": "agi+4",
					"Tags": 0,
					"Rarity": 0
				},
				{
					"Id": "homework1_2",
					"Title": "",
					"Des": "",
					"RstText": "情急之下，你抄了同学的作业。你俩的答案错得一模一样，被老师一眼看穿。你挨了一下午的训话。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"RstValue": "end+4",
					"Tags": 0,
					"Rarity": 0
				},
				{
					"Id": "homework1_3",
					"Title": "",
					"Des": "",
					"RstText": "你勇敢地承认了自己的过失，老师让你明天再补交。",
					"Priority": 0,
					"EventType": 4,
					"Icon": "",
					"RstValue": "str+4",
					"Tags": 0,
					"Rarity": 0
				},
