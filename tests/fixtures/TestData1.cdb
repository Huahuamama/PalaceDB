					"RstValue": "end+5, str-1",
					"Condition": "golf<=3",
					"EventType": 4,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "golf_match",
					"Title": "业余高尔夫球赛",
					"Des": "你决定报名参加业余高尔夫球赛。",
					"RstText": "golf_match1, golf_match2",
					"Priority": 0,
					"EventType": 2,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "golf_match1",
					"Title": "",
					"Des": "",
					"RstText": "你轻松赢得了比赛！",
					"Priority": 0,
					"Condition": "golf>=5",
					"RstValue": "end+5, pop+5",
					"EventType": 4,
					"Icon": "",
					"Rarity": 0
