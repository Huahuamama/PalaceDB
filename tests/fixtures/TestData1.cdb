					"Condition": "hoodie==1",
					"RstValue": "agi+5",
					"EventType": 4,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "castle3",
					"Title": "",
					"Des": "",
					"RstText": "你在古堡的墙壁上看到一个血红色的符号！[p]你仔细一看，上面写的是“王二到此一游”。",
					"Priority": 0,
					"RstValue": "str+5",
					"EventType": 4,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "castle4",
					"Title": "",
					"Des": "",
					"RstText": "你看到一个幽灵在古堡内徘徊。他自称是城堡的主人河马公爵。[p]数百年前他战死在城堡，如今他的鬼魂依旧在等待胜利的号角。",
					"Priority": 0,
					"RstValue": "int+5, see_duke=1",
