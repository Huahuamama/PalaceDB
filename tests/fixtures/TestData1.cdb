					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "museum3",
					"Title": "当代艺术展",
					"Des": "博物馆在展出数百件当代艺术品。",
					"RstText": "摆在最大展厅中心的是一个红色按钮，如果你按了它，你的身后就会传出放屁的声音。",
					"Priority": 0,
					"Condition": "money>=2",
					"RstValue": "money-2, end+5",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "volunteer",
					"Title": "博物馆志愿者",
					"Des": "河马市博物馆正在聘请志愿者帮忙检票。除了工资收入，你也可以免费参观博物馆。",
					"RstText": "检票很无聊。但你把握机会参观了许多稀有展品。",
					"Priority": 0,
					"RstValue": "money+40, int+1",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "castle",
					"Title": "古堡探秘",
					"Des": "河马市惟一的中世纪城堡，很适合历史爱好者参观。",
					"RstText": "castle1, castle2, castle3, castle4",
					"Priority": 0,
					"EventType": 2,
					"Condition": "money>=10",
					"RstValue": "money-10",
