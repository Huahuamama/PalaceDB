			"lines": [
				{
					"Id": "weed",
					"Title": "除草",
					"Des": "",
					"RstText": "为了从父母手上赚点零花钱，你给自家的草坪除了草。",
					"Priority": 0,
					"RstValue": "end+1, money+40",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "talent_show",
					"Title": "才艺比赛",
					"Des": "",
					"RstText": "社区举行了青少年才艺比赛。你上台献唱了一首歌。",
					"Priority": 0,
					"Condition": "music==1",
					"RstValue": "agi+3",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "talent_show1",
					"Title": "才艺比赛",
					"Des": "",
					"RstText": "社区举行了青少年才艺比赛。你和朋友们表演了一场舞蹈。",
					"Priority": 0,
					"Condition": "dancing==1",
					"RstValue": "agi+3",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "squirrel_feeder",
					"Title": "松鼠的好朋友",
					"Des": "",
					"RstText": "你在自家后院制作了一个松鼠喂食器。",
					"Priority": 0,
					"RstValue": "pop+2, agi+1",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "lego_master",
					"Title": "乐高大师",
					"Des": "",
					"RstText": "你妈妈从网上订购了一个大衣柜，你花了一个下午把它组装了起来。除了开门的时候有吱呀声，一切都很完美。",
					"Priority": 0,
					"RstValue": "str+3",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				},
				{
					"Id": "birthday_party",
					"Title": "生日派对",
					"Des": "",
					"RstText": "你的父母为你精心准备了生日派对。你所有的朋友都来了，你切了蛋糕，许了愿，还收到了许多礼物。",
					"Priority": 0,
					"RstValue": "pop+3",
					"EventType": 0,
					"Icon": "",
					"Rarity": 0
				}
			],
			"separators": [],
			"props": {}
		},
