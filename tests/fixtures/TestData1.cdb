				},
				{
					"Id": "fruit_pizza",
					"Title": "水果披萨",
					"Des": "开在小吃街的水果披萨专卖店，尽管有许多人抵制，但生意却出奇地好。",
					"RstText": "fruit_pizza1, fruit_pizza2, fruit_pizza3",
					"Priority": 0,
					"EventType": 18,
					"Condition": "money>=5",
					"RstValue": "money-5",
					"Icon": "food",
					"Tags": 0,
					"Rarity": 0
				},
				{
					"Id": "fruit_pizza1",
					"Title": "",
					"Des": "",
					"RstText": "你买了一份榴莲披萨带回家。家里人都被你臭到了。但你吃得很开心。",
					"Priority": 0,
					"EventType": 4,
					"RstValue": "pop-1,end+5",
					"Icon": "",
					"Tags": 0,
					"Rarity": 0
				},
				{
					"Id": "fruit_pizza2",
					"Title": "",
					"Des": "",
					"RstText": "因为正好要去约会，你为自己和恋人买了两块菠萝披萨。",
					"Priority": 0,
					"EventType": 4,
					"Condition": "isInLove==1",
					"RstValue": "money-5, pop+2, end+2, lover_quarrel-1",
					"Icon": "date",
					"Tags": 256,
					"Rarity": 0
				},
				{
					"Id": "fruit_pizza3",
					"Title": "",
					"Des": "",
					"RstText": "这份披萨里加了火龙果和芒果，十分香甜。你宣布这是你最喜欢的披萨口味。",
					"Priority": 0,
