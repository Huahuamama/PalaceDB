					"EventType": 0,
					"Bool": false
				},
				{
					"Id": "graduation_trip_end",
					"Title": "毕业旅行",
					"Des": "",
					"RstText": "你约了几个要好的同学一起毕业旅行。你们在郊外露营。你独自拣柴的时候遇到了棕熊。你赶紧憋气装死。棕熊拿出一块怀表计时。过了20分钟后，它确信你是死了，才遗憾地离开了。",
					"Priority": 10,
					"LockedInDemo": false,
					"Icon": "party",
